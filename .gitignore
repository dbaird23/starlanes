# Dependencies
node_modules/

# Build output
dist/

# NOTE: public/nova/ IS tracked, so a clone runs without a copy of the game to
# hand. It is ~98 MB of PNG/WAV decoded out of the retail .rez files, and those
# don't delta — re-extracting and recommitting adds the full 98 MB to history
# again. Prefer `git commit --amend` over a fresh commit when you re-extract.

# macOS
.DS_Store

# Grok-only local project notes (not shared with Claude Code teammates)
AGENTS.md
/dev-dist/
/docs/

# Finder/sync duplicates ("game 2.ts", "shipinfo-20129 2.png"). These are junk,
# but tsconfig globs src/**, so a stray "game 2.ts" breaks `npx tsc --noEmit`
# with errors that have nothing to do with your code. 32 of them turned up at
# once from a sync; ignore them so they never get committed by `git add -A`.
* 2.*
* [0-9].*

# Throwaway probe scripts. Automated browser probes have to live inside the
# repo so `require('pngjs')` resolves against node_modules, so they land here
# rather than in a scratch directory. They are never part of the build.
/scratch-*.mjs
/*-probe.mjs
/probe*.mjs
